#!/bin/bash
# Clone and build the OB-USP-Agent
git clone https://github.com/BroadbandForum/obuspa.git
cd obuspa

# Install dependencies (Ubuntu/Debian example)
sudo apt-get update
sudo apt-get install -y build-essential git cmake libssl-dev libcurl4-openssl-dev libsqlite3-dev libmosquitto-dev libcoap-dev

# Build the agent
mkdir build
cd build
cmake ..
make
sudo make install

# Return to original directory
cd ../..

